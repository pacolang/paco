struct Grid<T: Numeric, const D: int...> {
    data: []T,

    pub fn zeros() -> Self {
        let dims = D;
        Grid { data: slice_of_zeros<T>(product(&dims)) }
    }

    pub fn len(&self) -> i64 {
        self.data.len()
    }
}

fn product(dims: &[]i64) -> i64 {
    let mut count = 1;
    for i in 0..dims.len() {
        count = count * dims[i];
    }
    count
}

fn halve<const N: int>(a: Grid<f32, (2 * N) / 2>) -> Grid<f32, N> {
    a
}

fn main() {
    print(halve<3>(Grid<f32, 3>::zeros()).len());
}
