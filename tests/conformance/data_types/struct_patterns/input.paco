struct Point {
    x: i64,
    y: i64
}

struct Line {
    from: Point,
    to: Point
}

enum Shape {
    Circle(i64),
    Segment(Line),
    Dot(Point)
}

fn describe(p: Point) -> i64 {
    match p {
        Point { x: 0, y } => y,
        Point { x, y: 0 } => x * 10,
        Point { x, y } if x == y => 1000,
        Point { x: a, .. } => a + 1
    }
}

fn pick(s: Shape) -> i64 {
    match s {
        Shape::Circle(1 | 2) => 7,
        Shape::Circle(r) | Shape::Dot(Point { x: r, .. }) if r > 100 => r,
        Shape::Segment(Line { from: Point { x: a, y: b }, to: Point { x: c, y: d } }) => a + b + c + d,
        Shape::Dot(Point { x, y: 3 | 4 }) => x * 3,
        Shape::Circle(r) => r * 2,
        Shape::Dot(_) => 0
    }
}

fn main() {
    print(describe(Point { x: 0, y: 5 }));
    print(describe(Point { x: 3, y: 0 }));
    print(describe(Point { x: 4, y: 4 }));
    print(describe(Point { x: 2, y: 9 }));
    print(pick(Shape::Circle(2)));
    print(pick(Shape::Circle(200)));
    print(pick(Shape::Dot(Point { x: 300, y: 1 })));
    print(pick(Shape::Segment(Line { from: Point { x: 1, y: 2 }, to: Point { x: 3, y: 4 } })));
    print(pick(Shape::Dot(Point { x: 5, y: 4 })));
    print(pick(Shape::Circle(9)));
    print(pick(Shape::Dot(Point { x: 5, y: 5 })));
    let Line { from: Point { x, y }, to } = Line { from: Point { x: 6, y: 7 }, to: Point { x: 8, y: 9 } };
    print(x + y + to.x + to.y)
}
