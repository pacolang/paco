struct Point {
    x: i64,
    y: i64,

    fn new(x: i64, y: i64) -> Point {
        Point { x: x, y: y }
    }

    fn get_x(&self) -> i64 {
        self.x
    }

    fn get_y(&self) -> i64 {
        self.y
    }

    fn add(&self, other: &Point) -> Point {
        Point { x: self.x + other.x, y: self.y + other.y }
    }
}

fn main() {
    let p1 = Point::new(10, 20);
    let p2 = Point::new(30, 40);
    let p3 = p1.add(&p2);
    print(p3.get_x());
    print(p3.get_y())
}
