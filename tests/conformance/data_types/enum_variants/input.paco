enum Shape {
    Circle(i64),
    Rectangle(i64, i64)
}

fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rectangle(w, h) => w * h
    }
}

fn main() {
    let c = Shape::Circle(5);
    let r = Shape::Rectangle(10, 20);
    print(area(c));
    print(area(r))
}
