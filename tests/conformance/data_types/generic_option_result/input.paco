enum Option<T> {
    Some(T),
    None
}

enum Result<T, E> {
    Ok(T),
    Err(E)
}

fn unwrap_or(opt: Option<i64>, default: i64) -> i64 {
    match opt {
        Option::Some(x) => x,
        Option::None => default
    }
}

fn main() {
    let x: Option<i64> = Option::Some(42);
    let y: Option<i64> = Option::None;
    print(unwrap_or(x, 0));
    print(unwrap_or(y, 100));

    let r1: Result<i64, string> = Result::Ok(123);
    let r2: Result<i64, string> = Result::Err("failed");

    match r1 {
        Result::Ok(val) => print(val),
        Result::Err(err) => print(err)
    }

    match r2 {
        Result::Ok(val) => print(val),
        Result::Err(err) => print(err)
    }
}
