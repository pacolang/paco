struct Point {
    x: i64,
    y: i64,
    label: string,
}

enum Shape {
    Circle(i64),
    Rect(i64, i64),
    Empty,
}

fn corner() -> Point {
    Point { x: 3, y: -4, label: "corner" }
}

fn shape(kind: i64) -> Shape {
    if kind == 0 {
        Shape::Circle(5)
    } else if kind == 1 {
        Shape::Rect(2, 7)
    } else {
        Shape::Empty
    }
}

fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Empty => 0,
    }
}

fn distance(p: Point) -> i64 {
    let ax = if p.x < 0 { 0 - p.x } else { p.x };
    let ay = if p.y < 0 { 0 - p.y } else { p.y };
    ax + ay
}

fn label(p: Point) -> string {
    p.label
}

fn main() {
    print(distance(corner()));
    print(label(corner()));
    print(area(shape(0)));
    print(area(shape(1)));
    print(area(shape(2)));
}
