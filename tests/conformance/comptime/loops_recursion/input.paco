fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn collatz(start: i64) -> i64 {
    let mut n = start;
    let mut steps = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps = steps + 1;
    }
    steps
}

fn sum_to(limit: i64) -> i64 {
    let mut total = 0;
    for i in 0..limit {
        total = total + i;
    }
    total
}

fn primes_below(limit: i64) -> i64 {
    let mut count = 0;
    let mut n = 2;
    loop {
        if n >= limit {
            break;
        }
        let mut d = 2;
        let mut prime = true;
        while d * d <= n {
            if n % d == 0 {
                prime = false;
            }
            d = d + 1;
        }
        if prime {
            count = count + 1;
        }
        n = n + 1;
    }
    count
}

fn main() {
    print(fib(15));
    print(gcd(1071, 462));
    print(collatz(27));
    print(sum_to(100));
    print(primes_below(100));
}
