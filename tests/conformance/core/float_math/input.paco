fn zero() -> float {
    0.0
}

fn negative_zero() -> float {
    -zero()
}

fn nan() -> float {
    zero() / zero()
}

fn neg(x: float) -> float {
    -x
}

fn infinity() -> float {
    1.0 / zero()
}

fn f32_math(x: f32, y: f32) -> f32 {
    x.sqrt() + x.exp() + x.ln() + x.sin() + x.cos() + x.tanh() + x.powf(y) + x.min(y) + x.max(y) + x.abs()
}

fn f16_math(x: f16, y: f16) -> f16 {
    x.sqrt() + x.exp() + x.ln() + x.sin() + x.cos() + x.tanh() + x.powf(y) + x.min(y) + x.max(y) + x.abs()
}

fn bf16_math(x: bf16, y: bf16) -> bf16 {
    x.sqrt() + x.exp() + x.ln() + x.sin() + x.cos() + x.tanh() + x.powf(y) + x.min(y) + x.max(y) + x.abs()
}

fn main() {
    print(zero().sqrt());
    print(negative_zero().sqrt());
    print(neg(4.0).sqrt());
    print(2.0.sqrt());
    print(infinity().sqrt());
    print(zero().exp());
    print(710.0.exp());
    print(neg(746.0).exp());
    print(1.0.exp());
    print(1.0.ln());
    print(zero().ln());
    print(neg(1.0).ln());
    print(10.0.ln());
    print(zero().sin());
    print(negative_zero().sin());
    print(10000000000000000000000.0.sin());
    print(zero().cos());
    print(10000000000000000000000.0.cos());
    print(zero().tanh());
    print(20.0.tanh());
    print(neg(20.0).tanh());
    print(0.5.tanh());
    print(2.0.powf(10.0));
    print(zero().powf(zero()));
    print(nan().powf(zero()));
    print(1.0000001.powf(10000000.0));
    print(neg(2.0).powf(0.5));
    print(neg(3.5).abs());
    print(negative_zero().abs());
    print(1.0.min(2.0));
    print(1.0.max(2.0));
    print(negative_zero().min(zero()));
    print(zero().max(negative_zero()));
    print(nan().min(1.0));
    print(1.0.max(nan()));
    print(f32_math(0.75 as f32, 1.5 as f32));
    print(f16_math(0.75 as f16, 1.5 as f16));
    print(bf16_math(0.75 as bf16, 1.5 as bf16));
}
