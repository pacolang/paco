fn run_i8(pair: i64, op: i64, flag: bool) -> i8 {
    if pair == 0 {
        let a: i8 = 126;
        let b: i8 = 3;
        if flag {
            let one: i8 = 1;
            let zero: i8 = 0;
            return if flag_i8(a, b, op) { one } else { zero };
        }
        return ops_i8(a, b, op);
    }
    if pair == 1 {
        let a: i8 = -127;
        let b: i8 = 3;
        if flag {
            let one: i8 = 1;
            let zero: i8 = 0;
            return if flag_i8(a, b, op) { one } else { zero };
        }
        return ops_i8(a, b, op);
    }
    if pair == 2 {
        let a: i8 = 5;
        let b: i8 = 7;
        if flag {
            let one: i8 = 1;
            let zero: i8 = 0;
            return if flag_i8(a, b, op) { one } else { zero };
        }
        return ops_i8(a, b, op);
    }
    let none: i8 = 0;
    none
}

fn ops_i8(a: i8, b: i8, op: i64) -> i8 {
    if op == 0 { return a.wrapping_add(b); }
    if op == 1 { return a.wrapping_sub(b); }
    if op == 2 { return a.wrapping_mul(b); }
    if op == 3 { return a.saturating_add(b); }
    if op == 4 { return a.saturating_sub(b); }
    if op == 5 { return a.saturating_mul(b); }
    let checked = if op == 6 { a.checked_add(b) } else if op == 7 { a.checked_sub(b) } else { a.checked_mul(b) };
    if op < 9 {
        return match checked {
            Some(v) => v,
            None => a,
        };
    }
    let (r, o) = if op == 9 { a.overflowing_add(b) } else if op == 10 { a.overflowing_sub(b) } else { a.overflowing_mul(b) };
    r
}

fn flag_i8(a: i8, b: i8, op: i64) -> bool {
    if op == 6 { return a.checked_add(b).is_none(); }
    if op == 7 { return a.checked_sub(b).is_none(); }
    if op == 8 { return a.checked_mul(b).is_none(); }
    let (r, o) = if op == 9 { a.overflowing_add(b) } else if op == 10 { a.overflowing_sub(b) } else { a.overflowing_mul(b) };
    o
}

