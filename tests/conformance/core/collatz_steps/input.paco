fn steps(start: i64) -> i64 {
    let mut n = start;
    let mut count: i64 = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        count = count + 1;
    }
    count
}

fn main() {
    let mut longest: i64 = 0;
    let mut best: i64 = 0;
    let mut i: i64 = 1;
    while i < 3000 {
        let s = steps(i);
        if s > longest {
            longest = s;
            best = i;
        }
        i = i + 1;
    }
    print(best);
    print(longest);
}
