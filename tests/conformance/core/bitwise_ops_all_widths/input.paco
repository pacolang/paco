fn ops_i8(op: i64) -> i8 {
    let a: i8 = -100;
    let b: i8 = 45;
    let s: u32 = 3;
    let top: i64 = 7;
    if op == 0 { a & b } else if op == 1 { a | b } else if op == 2 { a ^ b } else if op == 3 { ~a }
    else if op == 4 { a << s } else if op == 5 { a >> s } else if op == 6 { b << top } else { a >> top }
}

fn ops_i16(op: i64) -> i16 {
    let a: i16 = -100;
    let b: i16 = 45;
    let s: u32 = 3;
    let top: i64 = 15;
    if op == 0 { a & b } else if op == 1 { a | b } else if op == 2 { a ^ b } else if op == 3 { ~a }
    else if op == 4 { a << s } else if op == 5 { a >> s } else if op == 6 { b << top } else { a >> top }
}

fn ops_i32(op: i64) -> i32 {
    let a: i32 = -100;
    let b: i32 = 45;
    let s: u32 = 3;
    let top: i64 = 31;
    if op == 0 { a & b } else if op == 1 { a | b } else if op == 2 { a ^ b } else if op == 3 { ~a }
    else if op == 4 { a << s } else if op == 5 { a >> s } else if op == 6 { b << top } else { a >> top }
