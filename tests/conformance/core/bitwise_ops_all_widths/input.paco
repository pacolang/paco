fn ops_u8(op: i64) -> u8 {
    let ninety_nine: u8 = 99;
    let a: u8 = ~ninety_nine;
    let b: u8 = 45;
    let s: u32 = 3;
    let top: i64 = 7;
    if op == 0 { a & b } else if op == 1 { a | b } else if op == 2 { a ^ b } else if op == 3 { ~a }
    else if op == 4 { a << s } else if op == 5 { a >> s } else if op == 6 { b << top } else { a >> top }
}

fn ops_u16(op: i64) -> u16 {
    let ninety_nine: u16 = 99;
    let a: u16 = ~ninety_nine;
    let b: u16 = 45;
    let s: u32 = 3;
    let top: i64 = 15;
    if op == 0 { a & b } else if op == 1 { a | b } else if op == 2 { a ^ b } else if op == 3 { ~a }
    else if op == 4 { a << s } else if op == 5 { a >> s } else if op == 6 { b << top } else { a >> top }
}

fn ops_u32(op: i64) -> u32 {
    let ninety_nine: u32 = 99;
    let a: u32 = ~ninety_nine;
    let b: u32 = 45;
    let s: u32 = 3;
    let top: i64 = 31;
    if op == 0 { a & b } else if op == 1 { a | b } else if op == 2 { a ^ b } else if op == 3 { ~a }
    else if op == 4 { a << s } else if op == 5 { a >> s } else if op == 6 { b << top } else { a >> top }
}

fn ops_u64(op: i64) -> u64 {
    let ninety_nine: u64 = 99;
    let a: u64 = ~ninety_nine;
    let b: u64 = 45;
    let s: u32 = 3;
    let top: i64 = 63;
    if op == 0 { a & b } else if op == 1 { a | b } else if op == 2 { a ^ b } else if op == 3 { ~a }
    else if op == 4 { a << s } else if op == 5 { a >> s } else if op == 6 { b << top } else { a >> top }
}

fn precedence() -> bool {
    let x: i64 = 6;
    x & 1 == 0 && (1 | 2 ^ 3 & 4 << 1) == 3 && (x >> 1 + 1) == 1 && ~x & 7 == 1
}

fn main() {
    print(ops_i8(0));
    print(ops_i8(1));
    print(ops_i8(2));
    print(ops_i8(3));
    print(ops_i8(4));
