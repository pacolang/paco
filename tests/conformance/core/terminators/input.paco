fn classify(n: i64) -> i64 {
    if n < 0 {
        panic("negative input");
    }
    match n % 3 {
        0 => 10,
        1 => 20,
        _ => 30,
    }
}

fn first_over(limit: i64) -> i64 {
    let mut i: i64 = 0;
    loop {
        if i * i > limit {
            return i;
        }
        i = i + 1;
    }
}

fn main() {
    let scale = 2;
    let twice = |x: i64| x * scale;
    let mut total: i64 = 0;
    let mut n: i64 = 0;
    while n < 6 {
        total = total + twice(classify(n));
        n = n + 1;
    }
    print(total);
    print(first_over(50));
}
