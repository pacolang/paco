fn energy(x: &[]f64, y: &[]f64, z: &[]f64, vx: &[]f64, vy: &[]f64, vz: &[]f64, m: &[]f64) -> f64 {
    let mut e: f64 = 0.0;
    let n = x.len();
    for i in 0..n {
        e = e + 0.5 * m[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i]);
        for j in (i + 1)..n {
            let dx = x[i] - x[j];
            let dy = y[i] - y[j];
            let dz = z[i] - z[j];
            e = e - m[i] * m[j] / (dx * dx + dy * dy + dz * dz).sqrt();
        }
    }
    e
}

fn main() {
    let pi: f64 = 3.141592653589793;
    let sm: f64 = 4.0 * pi * pi;
    let dp: f64 = 365.24;
    let n: i64 = 5;
    let mut x: []f64 = slice_of_zeros<f64>(n);
    let mut y: []f64 = slice_of_zeros<f64>(n);
    let mut z: []f64 = slice_of_zeros<f64>(n);
    let mut vx: []f64 = slice_of_zeros<f64>(n);
    let mut vy: []f64 = slice_of_zeros<f64>(n);
    let mut vz: []f64 = slice_of_zeros<f64>(n);
    let mut m: []f64 = slice_of_zeros<f64>(n);
    m[0] = sm;
    x[1] = 4.84143144246472090; y[1] = -1.16032004402742839; z[1] = -0.103622044471123109;
    vx[1] = 0.00166007664274403694 * dp; vy[1] = 0.00769901118419740425 * dp; vz[1] = -0.0000690460016972063023 * dp;
    m[1] = 0.000954791938424326609 * sm;
    x[2] = 8.34336671824457987; y[2] = 4.12479856412430479; z[2] = -0.403523417114321381;
    vx[2] = -0.00276742510726862411 * dp; vy[2] = 0.00499852801234917238 * dp; vz[2] = 0.0000230417297573763929 * dp;
    m[2] = 0.000285885980666130812 * sm;
    x[3] = 12.8943695621391310; y[3] = -15.1111514016986312; z[3] = -0.223307578892655734;
    vx[3] = 0.00296460137564761618 * dp; vy[3] = 0.00237847173959480950 * dp; vz[3] = -0.0000296589568540237556 * dp;
    m[3] = 0.0000436624404335156298 * sm;
    x[4] = 15.3796971148509165; y[4] = -25.9193146099879641; z[4] = 0.179258772950371181;
    vx[4] = 0.00268067772490389322 * dp; vy[4] = 0.00162824170038242295 * dp; vz[4] = -0.0000951592254519715870 * dp;
    m[4] = 0.0000515138902046611451 * sm;
    let mut px: f64 = 0.0;
    let mut py: f64 = 0.0;
    let mut pz: f64 = 0.0;
    for i in 0..n {
        px = px + vx[i] * m[i];
        py = py + vy[i] * m[i];
        pz = pz + vz[i] * m[i];
    }
    vx[0] = -px / sm;
    vy[0] = -py / sm;
    vz[0] = -pz / sm;
    print(energy(&x, &y, &z, &vx, &vy, &vz, &m));
    let dt: f64 = 0.01;
    let steps: i64 = 1000;
    for s in 0..steps {
        for i in 0..n {
            for j in (i + 1)..n {
                let dx = x[i] - x[j];
                let dy = y[i] - y[j];
                let dz = z[i] - z[j];
                let d2 = dx * dx + dy * dy + dz * dz;
                let mag = dt / (d2 * d2.sqrt());
                let mj = m[j] * mag;
                let mi = m[i] * mag;
                vx[i] = vx[i] - dx * mj;
                vy[i] = vy[i] - dy * mj;
                vz[i] = vz[i] - dz * mj;
                vx[j] = vx[j] + dx * mi;
                vy[j] = vy[j] + dy * mi;
                vz[j] = vz[j] + dz * mi;
            }
        }
        for i in 0..n {
            x[i] = x[i] + dt * vx[i];
            y[i] = y[i] + dt * vy[i];
            z[i] = z[i] + dt * vz[i];
        }
    }
    print(energy(&x, &y, &z, &vx, &vy, &vz, &m));
}
