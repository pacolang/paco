module boxmod;

// Same root cause as `derivative_cross_module_multiple_registrations`
// (task 3.2d), but the method read off the returned gradient lives in a
// `methods<>` block with its own extra bounds rather than the struct body
// — PACO-E0314 ("method not found") at type-check time instead of a
// lowering-time panic, from the same unqualified-type leak.
pub struct Box<T: Numeric + Add> {
    pub v: T,
    type Tangent = Box<T>;

    pub fn zero_tangent(&self) -> Box<T> {
        let zero = slice_of_zeros<T>(1);
        Box { v: zero[0] }
    }

    pub fn move_by(&mut self, offset: &Box<T>) {
        self.v = self.v + offset.v
    }

    pub fn get(&self) -> T {
        self.v
    }
}

methods<T: Numeric + Add + Mul> Box<T> {
    pub fn doubled(&self) -> T {
        self.v * self.v
    }
}

pub struct GetPullback<T> {
    type Seed = T;
    type Gradients = Box<T>;

    pub fn pullback(self, seed: T) -> Box<T> {
        Box { v: seed }
    }
}

#[derivative(of = Box::get)]
pub fn get_derivative<T: Numeric + Add>(b: Box<T>) -> (T, GetPullback<T>) {
    (b.get(), GetPullback { })
}
