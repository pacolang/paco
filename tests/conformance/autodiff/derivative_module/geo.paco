module geo;

pub struct Vec2 {
    pub x: f64,
    pub y: f64,
    type Tangent = Vec2;

    pub fn zero_tangent(&self) -> Vec2 {
        Vec2 { x: 0.0, y: 0.0 }
    }

    pub fn move_by(&mut self, offset: &Vec2) {
        self.x = self.x + offset.x;
        self.y = self.y + offset.y
    }
}

pub fn norm(v: &Vec2) -> f64 {
    (v.x * v.x + v.y * v.y).sqrt()
}

/// Deliberately 100 times the true gradient, to show it is the one used.
pub struct NormPullback {
    v: Vec2,
    n: f64,
    type Seed = f64;
    type Gradients = Vec2;

    pub fn pullback(self, seed: f64) -> Vec2 {
        Vec2 { x: 100.0 * seed * self.v.x / self.n, y: 100.0 * seed * self.v.y / self.n }
    }
}

#[derivative(of = norm)]
pub fn norm_derivative(v: &Vec2) -> (f64, NormPullback) {
    let n = norm(v);
    (n, NormPullback { v: Vec2 { x: v.x, y: v.y }, n: n })
}
