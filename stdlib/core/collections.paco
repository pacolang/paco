module core;

pub struct Vec<T> {
    data: []T,
    len: i64,
    cap: i64,

    pub fn new() -> Self {
        Vec { data: slice_of_zeros<T>(0), len: 0, cap: 0 }
    }

    pub fn push(&mut self, value: T) {
        if self.len >= self.cap {
            let new_cap: i64 = if self.cap == 0 { 4 } else { self.cap * 2 };
            let mut new_data: []T = slice_of_zeros<T>(new_cap);
            for i in 0..self.len {
                new_data[i] = self.data[i]
            }
            self.data = new_data;
            self.cap = new_cap
        }
        self.data[self.len] = value;
        self.len = self.len + 1
    }

    pub fn get(&self, i: i64) -> Option<T> {
        if i < 0 || i >= self.len {
            Option::None
        } else {
            Option::Some(self.data[i])
        }
    }

    pub fn len(&self) -> i64 {
        self.len
    }

    pub fn index(&self, i: i64) -> &T {
        &self.data[i]
    }

    pub fn set(&mut self, i: i64, value: T) {
        self.data[i] = value
    }
}

/// A hash table with open addressing and linear probing. The capacity is a
/// power of two and at most half full, so every operation is expected O(1).
pub struct Map<K, V> {
    keys: []K,
    values: []V,
    used: []bool,
    len: i64,

    pub fn new() -> Self {
        Map { keys: slice_of_zeros<K>(0), values: slice_of_zeros<V>(0), used: slice_of_zeros<bool>(0), len: 0 }
    }

    pub fn len(&self) -> i64 {
        self.len
    }
}

pub methods<K: Hash + Eq, V> Map<K, V> {
    pub fn insert(&mut self, key: K, value: V) {
        if (self.len + 1) * 2 > self.keys.len() {
            self.grow();
        }
        let slot = self.slot_of(&key);
        if !self.used[slot] {
            self.used[slot] = true;
            self.len = self.len + 1;
        }
        self.keys[slot] = key;
        self.values[slot] = value;
    }

    /// The value stored under `key`, inserting `default` first when the key
    /// is absent; one lookup, e.g. `let n = m.get_or_insert(k, 0); *n = *n + 1;`.
    pub fn get_or_insert(&mut self, key: K, default: V) -> &mut V {
        if (self.len + 1) * 2 > self.keys.len() {
            self.grow();
        }
        let slot = self.slot_of(&key);
        let present = self.used[slot];
        self.keys[slot] = key;
        if present {
            let unused = default;
        } else {
            self.used[slot] = true;
            self.len = self.len + 1;
            self.values[slot] = default;
        }
        &mut self.values[slot]
    }

    pub fn get(&self, key: K) -> Option<V> {
        if self.len == 0 {
            return Option::None;
        }
        let slot = self.slot_of(&key);
        if self.used[slot] {
            Option::Some(self.values[slot])
        } else {
            Option::None
        }
    }

    pub fn contains_key(&self, key: K) -> bool {
        if self.len == 0 {
            return false;
        }
        let slot = self.slot_of(&key);
        self.used[slot]
    }

    fn slot_of(&self, key: &K) -> i64 {
        slot_in(&self.keys, &self.used, key)
    }

    fn grow(&mut self) {
        let capacity = if self.keys.len() == 0 { 8 } else { self.keys.len() * 2 };
        let mut keys: []K = slice_of_zeros<K>(capacity);
        let mut values: []V = slice_of_zeros<V>(capacity);
        let mut used: []bool = slice_of_zeros<bool>(capacity);
        for i in 0..self.used.len() {
            if self.used[i] {
                let slot = slot_in(&keys, &used, &self.keys[i]);
                used[slot] = true;
                keys[slot] = self.keys[i];
                values[slot] = self.values[i];
            }
        }
        self.keys = keys;
        self.values = values;
        self.used = used;
    }
}

/// The slot of a power-of-two table holding `key`, or the empty slot where
/// it belongs.
fn slot_in<K: Hash + Eq>(keys: &[]K, used: &[]bool, key: &K) -> i64 {
    let mask = keys.len() - 1;
    let mut slot = (hash_of(key) & (mask as u64)) as i64;
    while used[slot] && !(keys[slot] == *key) {
        slot = (slot + 1) & mask;
    }
    slot
}

pub struct Set<T> {
    items: Map<T, bool>,

    pub fn new() -> Self {
        Set { items: Map::new() }
    }

    pub fn len(&self) -> i64 {
        self.items.len()
    }
}

pub methods<T: Hash + Eq> Set<T> {
    pub fn insert(&mut self, value: T) {
        self.items.insert(value, true)
    }

    pub fn contains(&self, value: T) -> bool {
        self.items.contains_key(value)
    }
}

pub struct StringBuf {
    bytes: []byte,
    len: i64,

    pub fn new() -> Self {
        StringBuf { bytes: slice_of_zeros<byte>(0), len: 0 }
    }

    pub fn push_str(&mut self, s: string) {
        let n = string_len_bytes(&s);
        self.reserve(n);
        let _ = bytes_write_string(&mut self.bytes, self.len, &s);
        self.len = self.len + n;
    }

    pub fn push(&mut self, c: char) {
        let code = c as i64;
        if code < 128 {
            self.push_byte(code);
        } else if code < 2048 {
            self.push_byte(192 | (code >> 6));
            self.push_byte(128 | (code & 63));
        } else if code < 65536 {
            self.push_byte(224 | (code >> 12));
            self.push_byte(128 | ((code >> 6) & 63));
            self.push_byte(128 | (code & 63));
        } else {
            self.push_byte(240 | (code >> 18));
            self.push_byte(128 | ((code >> 12) & 63));
            self.push_byte(128 | ((code >> 6) & 63));
            self.push_byte(128 | (code & 63));
        }
    }

    /// The length in bytes.
    pub fn len(&self) -> i64 {
        self.len
    }

    pub fn to_string(&self) -> string {
        match string_from_bytes(&self.bytes, 0, self.len) {
            Some(s) => s,
            None => panic("StringBuf holds invalid UTF-8"),
        }
    }

    fn push_byte(&mut self, b: i64) {
        self.reserve(1);
        self.bytes[self.len] = b as byte;
        self.len = self.len + 1;
    }

    fn reserve(&mut self, extra: i64) {
        let needed = self.len + extra;
        let cap = self.bytes.len();
        if needed > cap {
            let mut new_cap = if cap == 0 { 16 } else { cap * 2 };
            while new_cap < needed {
                new_cap = new_cap * 2;
            }
            let mut grown: []byte = slice_of_zeros<byte>(new_cap);
            for i in 0..self.len {
                grown[i] = self.bytes[i];
            }
            self.bytes = grown;
        }
    }
}

pub methods<T: Ord> Vec<T> {
    /// Sorts the elements in ascending order. Stable, O(n log n).
    pub fn sort(&mut self) {
        sort_prefix(&mut self.data, self.len);
    }
}

pub methods<T> Vec<T> {
    /// Sorts with `compare`, which returns a negative number when its first
    /// argument orders first, zero when both are equal and a positive
    /// number otherwise. Stable, O(n log n).
    pub fn sort_by(&mut self, compare: fn(&T, &T) -> i64) {
        sort_prefix_by(&mut self.data, self.len, compare);
    }
}

pub methods<T: Ord> []T {
    /// Sorts the elements in ascending order. Stable, O(n log n).
    pub fn sort(&mut self) {
        let n = self.len();
        sort_prefix(&mut self, n);
    }
}

pub methods<T> []T {
    /// Sorts with `compare` (see `Vec::sort_by`). Stable, O(n log n).
    pub fn sort_by(&mut self, compare: fn(&T, &T) -> i64) {
        let n = self.len();
        sort_prefix_by(&mut self, n, compare);
    }
}

const SORT_RUN: i64 = 16;

/// Sorts `xs[0..n]`: primitives in the runtime, anything else by a
/// bottom-up merge sort (insertion-sorted runs, then merge passes that
/// alternate between `xs` and one scratch buffer).
fn sort_prefix<T: Ord>(xs: &mut []T, n: i64) {
    if slice_sort_native(xs, n) {
        return;
    }
    let mut start: i64 = 0;
    while start < n {
        let end = if start + SORT_RUN < n { start + SORT_RUN } else { n };
        for i in (start + 1)..end {
            let mut j = i;
            while j > start && xs[j] < xs[j - 1] {
                let moved = xs[j];
                xs[j] = xs[j - 1];
                xs[j - 1] = moved;
                j = j - 1;
            }
        }
        start = end;
    }
    let mut scratch: []T = slice_of_zeros<T>(n);
    let mut width = SORT_RUN;
    let mut in_xs = true;
    while width < n {
        if in_xs {
            merge_pass(xs, &mut scratch, n, width);
        } else {
            merge_pass(&mut scratch, xs, n, width);
        }
        in_xs = !in_xs;
        width = width * 2;
    }
    if !in_xs {
        for i in 0..n {
            xs[i] = scratch[i];
        }
    }
}

fn merge_pass<T: Ord>(src: &mut []T, dst: &mut []T, n: i64, width: i64) {
    let mut lo: i64 = 0;
    while lo < n {
        let mid = if lo + width < n { lo + width } else { n };
        let hi = if mid + width < n { mid + width } else { n };
        let mut i = lo;
        let mut j = mid;
        for k in lo..hi {
            if i < mid && (j >= hi || !(src[j] < src[i])) {
                dst[k] = src[i];
                i = i + 1;
            } else {
                dst[k] = src[j];
                j = j + 1;
            }
        }
        lo = hi;
    }
}

fn sort_prefix_by<T>(xs: &mut []T, n: i64, compare: fn(&T, &T) -> i64) {
    let mut compare = compare;
    let mut start: i64 = 0;
    while start < n {
        let end = if start + SORT_RUN < n { start + SORT_RUN } else { n };
        for i in (start + 1)..end {
            let mut j = i;
            while j > start && compare(&xs[j], &xs[j - 1]) < 0 {
                let moved = xs[j];
                xs[j] = xs[j - 1];
                xs[j - 1] = moved;
                j = j - 1;
            }
        }
        start = end;
    }
    let mut scratch: []T = slice_of_zeros<T>(n);
    let mut width = SORT_RUN;
    let mut in_xs = true;
    while width < n {
        if in_xs {
            compare = merge_pass_by(xs, &mut scratch, n, width, compare);
        } else {
            compare = merge_pass_by(&mut scratch, xs, n, width, compare);
        }
        in_xs = !in_xs;
        width = width * 2;
    }
    if !in_xs {
        for i in 0..n {
            xs[i] = scratch[i];
        }
    }
}

/// Hands `compare` back so the caller can use it for the next pass.
fn merge_pass_by<T>(src: &mut []T, dst: &mut []T, n: i64, width: i64, compare: fn(&T, &T) -> i64) -> fn(&T, &T) -> i64 {
    let mut lo: i64 = 0;
    while lo < n {
        let mid = if lo + width < n { lo + width } else { n };
        let hi = if mid + width < n { mid + width } else { n };
        let mut i = lo;
        let mut j = mid;
        for k in lo..hi {
            if i < mid && (j >= hi || compare(&src[j], &src[i]) >= 0) {
                dst[k] = src[i];
                i = i + 1;
            } else {
                dst[k] = src[j];
                j = j + 1;
            }
        }
        lo = hi;
    }
    compare
}
